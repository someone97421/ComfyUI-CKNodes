  },
  "Text_Concatenate": {
    "display_name": "CK 文本拼接",
    "description": "使用指定分隔符拼接最多四段文本，并可自动清理首尾空白。",
    "inputs": {
      "delimiter": { "name": "分隔符" },
      "clean_whitespace": { "name": "清理首尾空白", "options": { "true": "是", "false": "否" } },
      "text_a": { "name": "文本 A" },
      "text_b": { "name": "文本 B" },
      "text_c": { "name": "文本 C" },
      "text_d": { "name": "文本 D" }
    },
