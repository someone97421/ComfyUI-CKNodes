  "TextLineCount": {
    "display_name": "CK 文本行数统计",
    "description": "统计文本行数，可选择忽略空行和只包含空格的行。",
    "inputs": { "text": { "name": "文本" }, "ignore_empty_lines": { "name": "忽略空行" } },
