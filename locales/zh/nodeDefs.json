{
  "AnyListCount": {
    "display_name": "CK 任意列表计数",
    "description": "统计任意列表、图像批次、遮罩批次或 latent 批次的数量。",
    "inputs": {
      "any_input": { "name": "任意输入", "tooltip": "需要统计数量的任意类型输入。" }
    },
    "outputs": {
      "0": { "name": "数量" }
    }
  },
  "AnyNullNode": {
    "display_name": "CK 空值 / Null",
    "description": "输出一个可连接到任意类型接口的空值。",
    "outputs": {
      "0": { "name": "空值" }
    }
  },
  "AnyBooleanSwitch": {
    "display_name": "CK 任意类型布尔开关",
    "description": "开关开启时透传输入，关闭时输出空值。",
    "inputs": {
      "输入": { "name": "输入", "tooltip": "需要按开关控制的任意类型数据。" },
      "开关": { "name": "开关", "tooltip": "开启时透传，关闭时输出空值。" }
    },
    "outputs": {
      "0": { "name": "输出结果" }
    }
  },
  "ExtractFramesFromBatch": {
    "display_name": "CK 从批次提取帧",
    "description": "从 IMAGE 批次的指定索引开始，向前回溯或向后顺序提取若干帧。",
    "inputs": {
      "image": { "name": "图像批次", "tooltip": "需要提取帧的 IMAGE 批次。" },
      "start_index": { "name": "起始索引", "tooltip": "从零开始的参考帧索引。" },
      "direction": {
        "name": "提取方向",
        "tooltip": "选择从起始索引向较小索引回溯，或向较大索引顺序提取。",
        "options": {
          "forward": "向前回溯（索引递减）",
          "backward": "向后顺取（索引递增）"
        }
      },
      "frame_count": { "name": "提取帧数", "tooltip": "最多提取的帧数。" }
    },
    "outputs": {
      "0": { "name": "提取后的帧" }
    }
  },
  "CKMatchBatchFrameRate": {
    "display_name": "CK 批次帧率匹配抽帧",
    "description": "依据输入和输出 FPS，在时间轴上自动匹配最接近的源帧，避免固定间隔抽帧造成累计漂移。",
    "inputs": {
      "images": { "name": "输入帧批次", "tooltip": "按时间顺序排列的输入帧批次。" },
      "input_fps": { "name": "输入 FPS", "tooltip": "输入帧序列原本对应的帧率。" },
      "output_fps": { "name": "输出 FPS", "tooltip": "希望输出帧序列对应的帧率。高于输入 FPS 时会重复帧。" }
    },
    "outputs": {
      "0": { "name": "匹配后的帧" },
      "1": { "name": "匹配信息" }
    }
  },
  "Text_Load_From_File": {
    "display_name": "CK 从文件加载文本",
    "description": "读取 UTF-8 文本文件，忽略以 # 开头的注释行，并同时输出全文和行字典。",
    "inputs": {
      "file_path": { "name": "文件路径", "tooltip": "需要读取的文本文件完整路径。" },
      "dictionary_name": { "name": "字典名称", "tooltip": "使用 [filename] 时采用不带扩展名的文件名。" }
    },
    "outputs": {
      "0": { "name": "文本" },
      "1": { "name": "行字典" }
    }
  },
  "LTXVContext_TTP": {
    "display_name": "CK LTXV 上下文（正向）",
    "description": "将上一段视频编码为 LTXV 开头上下文，并通过 noise mask 控制上下文强度。",
    "inputs": {
      "latent": { "name": "目标 latent" },
      "previous_video": { "name": "上一段视频" },
      "vae": { "name": "VAE" },
      "context_latent_frames": { "name": "上下文 latent 帧数" },
      "context_strength": { "name": "上下文强度" }
    },
    "outputs": { "0": { "name": "latent" } }
  },
  "LTXVContext_Reverse_TTP": {
    "display_name": "CK LTXV 上下文（反向）",
    "description": "将下一段视频编码为 LTXV 结尾上下文，并通过 noise mask 控制上下文强度。",
    "inputs": {
      "latent": { "name": "目标 latent" },
      "next_video": { "name": "下一段视频" },
      "vae": { "name": "VAE" },
      "context_latent_frames": { "name": "上下文 latent 帧数" },
      "context_strength": { "name": "上下文强度" }
    },
    "outputs": { "0": { "name": "latent" } }
  },
  "MaskBorderDrawer": {
    "display_name": "CK 遮罩边框绘制",
    "description": "根据遮罩范围在图像上绘制矩形或圆角边框。",
    "inputs": {
      "image": { "name": "图像", "tooltip": "输入原图像。" },
      "mask": { "name": "遮罩", "tooltip": "用于确定绘制边框范围的遮罩。" },
      "stroke_width": { "name": "边框粗细", "tooltip": "边框宽度，单位为像素。" },
      "box_type": { "name": "边框类型", "options": { "rectangle": "矩形", "rounded": "圆角矩形" } },
      "expand_pixels": { "name": "范围扩展像素", "tooltip": "正数扩大范围，负数缩小范围。" },
      "red": { "name": "红色通道" },
      "green": { "name": "绿色通道" },
      "blue": { "name": "蓝色通道" },
      "corner_radius": { "name": "圆角半径", "tooltip": "仅在圆角矩形模式下生效。" },
      "draw_mode": { "name": "绘制模式", "options": { "separate": "分别绘制每个区域", "combined": "合并后绘制整体边框" } }
    },
    "outputs": { "0": { "name": "带边框图像" } }
  },
  "CKSmartMergeImages": {
    "display_name": "CK 智能图像融合",
    "description": "对编辑裁剪图进行定位、颜色匹配和羽化融合，再合回原图。",
    "inputs": {
      "original_image": { "name": "原始图像" },
      "edited_crop_B": { "name": "编辑后的裁剪图 B" },
      "original_crop_A": { "name": "原始裁剪图 A（可选）" },
      "alignment_mode": { "name": "对齐模式", "options": { "Auto": "自动对齐", "Force Pixel Snapping (Ref B)": "强制像素吸附（参考 B）", "Force Bridge(Ref A & B)": "强制桥接（参考 A 与 B）" } },
      "color_match": { "name": "颜色匹配方式", "options": { "SeamlessClone (PS Auto Blend)": "无缝克隆（类似 PS 自动混合）", "Adaptive Local (strong)": "自适应局部匹配（强）", "Histogram": "直方图匹配", "LAB_Mean": "LAB 均值匹配", "Alpha Soft Blend": "Alpha 柔和混合", "None": "不匹配" } },
      "feather_kernel": { "name": "羽化半径" },
      "adapt_thresh": { "name": "自适应差异阈值" },
      "adapt_align": { "name": "自适应预对齐强度" },
      "adapt_local_match": { "name": "自适应局部匹配方式", "options": { "Histogram": "直方图匹配", "LAB_Mean": "LAB 均值匹配", "Reinhard": "Reinhard 颜色迁移", "Adaptive Histogram": "自适应直方图", "None": "不匹配" } }
    },
    "outputs": { "0": { "name": "融合图像" } }
  },
  "NetDebugNodeAny": {
    "display_name": "CK 网络环境诊断",
    "description": "在控制台和节点界面显示当前代理、镜像及相关网络环境设置，并透传输入。",
    "inputs": { "any_input": { "name": "任意输入" } },
    "outputs": { "0": { "name": "透传输出" } }
  },
  "TemporaryNetSettings": {
    "display_name": "CK 临时网络设置",
    "description": "临时修改当前 ComfyUI 进程的代理、Pip、Git 和 Hugging Face 镜像设置。",
    "inputs": {
      "any_input": { "name": "任意输入" },
      "http_proxy": { "name": "HTTP/HTTPS 代理", "tooltip": "留空保持不变，输入 None 清除代理。" },
      "pip_mirror": { "name": "Pip 镜像" },
      "git_mirror": { "name": "Git/GitHub 镜像" },
      "huggingface_mirror": { "name": "Hugging Face 镜像" }
    },
    "outputs": { "0": { "name": "透传输出" } }
  },
  "QwenVL_Local_Loader": {
    "display_name": "CK Qwen3-VL 本地加载器",
    "description": "从 models/prompt_generator 加载本地 Qwen3-VL 模型，对图片或视频执行视觉语言推理。",
    "inputs": {
      "model_name": { "name": "模型名称" },
      "quantization": { "name": "量化方式", "options": { "4-bit (VRAM-friendly)": "4 位（节省显存）", "8-bit (Balanced)": "8 位（平衡）", "None (FP16)": "不量化（FP16）" } },
      "system_prompt": { "name": "系统提示词" },
      "user_prompt": { "name": "用户提示词" },
      "max_tokens": { "name": "最大生成 Token" },
      "temperature": { "name": "温度" },
      "top_p": { "name": "Top P" },
      "keep_model_loaded": { "name": "保持模型加载" },
      "seed": { "name": "随机种子" },
      "image": { "name": "图片" },
      "video": { "name": "视频帧" },
      "attention_mode": { "name": "注意力模式", "options": { "auto": "自动", "flash_attention_2": "Flash Attention 2", "sdpa": "PyTorch SDPA" } }
    },
    "outputs": { "0": { "name": "回复" } }
  },
  "SaveImageCK": {
    "display_name": "CK 保存图片与说明文本",
    "description": "保存 PNG 图片，并可为每张图片同时保存独立的 Caption 文本文件。",
    "inputs": {
      "images": { "name": "图片" },
      "filename_prefix": { "name": "文件名前缀" },
      "output_folder": { "name": "输出文件夹" },
      "caption_file_extension": { "name": "说明文件扩展名" },
      "caption": { "name": "说明文本" },
      "encoding": { "name": "文本编码", "options": { "utf-8": "UTF-8（推荐）", "gbk": "GBK（简体中文旧软件）", "utf-16": "UTF-16", "ascii": "ASCII（仅英文）", "shift_jis": "Shift-JIS（日文旧软件）", "latin-1": "Latin-1（西欧旧软件）" } }
    },
    "outputs": { "0": { "name": "文件名" } }
  },
  "SimpleOpenAI_LLM": {
